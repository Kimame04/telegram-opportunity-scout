# ==============================================================================
# Telegram Opportunity Scout Configuration
# ==============================================================================
# 1. Obtain personal Telegram API credentials from https://my.telegram.org:
#    - Sign in with your phone number -> API development tools -> Create app.
# 2. Obtain Google Gemini API key from https://aistudio.google.com:
#    - Required for LLM semantic evaluation of announcements against your profile.
# ==============================================================================

# Telegram MTProto API Credentials
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890

# Target Delivery & Channel Configuration
# Any public Telegram channel username (@channel) or invite link (https://t.me/joinchat/...)
TELEGRAM_CHANNEL_IDENTIFIER=https://t.me/your_opportunity_channel

# Where the digest should be delivered (your username e.g. @your_username or "me" for Saved Messages)
TELEGRAM_TARGET_HANDLE=me

# LLM Semantic Evaluation (Supply at least one: Google Gemini or OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Digest & Scoring Parameters
LOOKBACK_HOURS=24
MIN_RELEVANCE_SCORE=40
MAX_OPPORTUNITIES=5
